using UnityEngine;
using UnityEngine.SceneManagement;
using UnityEngine.UI;
public class CinematicaInicial : MonoBehaviour
{
    [Header("Elementos de la Cinemática")]
    public GameObject camaraRichie;
    public GameObject camaraExterior;
    public AudioSource sonidosAmbiente;
    public Text textoDialogo;
    public float tiempoCambioCamara = 5f;
    private float tiempoActual = 0f;
    private int etapa = 0;

    void Start()
    {
        camaraRichie.SetActive(true);
        camaraExterior.SetActive(false);
        textoDialogo.text = "";
        sonidosAmbiente.volume = 0f;
    }

    void Update()
    {
        tiempoActual += Time.deltaTime;

        switch (etapa)
        {
            case 0:
                sonidosAmbiente.volume = Mathf.Lerp(0f, 1f, tiempoActual / tiempoCambioCamara);
                if (tiempoActual >= tiempoCambioCamara)
                {
                    etapa++;
                    tiempoActual = 0f;
                    camaraRichie.SetActive(false);
                    camaraExterior.SetActive(true);
                    textoDialogo.text = "Humano: Limpien todo, que no quede nada";
                }
                break;
            case 1:
                if (tiempoActual >= 4f)
                {
                    etapa++;
                    tiempoActual = 0f;
                    textoDialogo.text = "Richie: ¡Diablos, se llevaron mi tesoro!";
                }
                break;
            case 2:
                if (tiempoActual >= 4f)
                {
                    etapa++;
                    tiempoActual = 0f;
                    textoDialogo.text = "";
                    IniciarJuego();
                }
                break;
        }
    }

    void IniciarJuego()
    {
        SceneManager.LoadScene("Nivel1");
    }
}
